<?xml version="1.0" encoding="utf-8"?>
<!-- 右侧上方：查询功能（最上方） + 翻译信息展示区 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- ===== 查询功能 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F7F7"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <EditText
            android:id="@+id/et_lookup_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入单词或句子后点「查询」"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:minWidth="0dp"
            android:textColor="#333333"
            android:textColorHint="#AAAAAA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_lookup_query"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="查询"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_lookup_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="清空"
            android:textColor="#666666"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- ===== 翻译信息展示（原浮动窗内容，字号已收小） ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 原文 + 发音 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_lookup_original"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_lookup_speak"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_ripple"
                    android:contentDescription="朗读"
                    android:padding="5dp"
                    android:src="@android:drawable/ic_media_play"
                    android:visibility="invisible" />

                <!-- 把当前查询的词加入词库：加入后左侧生词列表里不会再出现它 -->
                <TextView
                    android:id="@+id/btn_lookup_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:clickable="true"
                    android:contentDescription="加入词库"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="加入词库"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- 音标学习卡：英/美音标 + 音素拆分 + 发音要领 -->
            <include
                android:id="@+id/ipa_card"
                layout="@layout/view_ipa_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="#EEEEEE" />

            <!-- 译文 -->
            <TextView
                android:id="@+id/tv_lookup_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="40dp"
                android:text="选中文本后点击「查询」，或在上方输入内容"
                android:textColor="#999999"
                android:textSize="14sp" />

            <!-- 加载中 -->
            <LinearLayout
                android:id="@+id/layout_lookup_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="14dp"
                    android:layout_height="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="翻译中..."
                    android:textColor="#999999"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
