# Android / Kotlin / Gradle 忽略规则

# --- Gradle 构建输出 ---
.gradle/
build/
app/build/
app/.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar
*.war
*.aar
*.jniLibs

# --- IDE 配置 ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# --- 本地配置 ---
local.properties
*.keystore
*.jks
debug.keystore

# --- 系统文件 ---
.DS_Store
Thumbs.db
*.bak
*.log

# --- 生成的文件 ---
gen/
out/
bin/
obj/

# --- Kotlin ---
*.kotlin_module

# --- 环境变量 ---
.env
.env.local

# 本地 SDK 路径配置（每台机器不同）
local.properties

# --- NDK ---
.externalNativeBuild/

# --- 本地构建缓存（Kotlin session 等）---
.kotlin/

# --- 本地测试素材（字幕文件等，不随仓库分发）---
/test/